# ==============================================================================
# TUHOCAI.TOP - APACHE .HTACCESS DEVICE DETECTION & MOBILE ENFORCEMENT
# Tự động nhận diện thiết bị (Mobile / Tablet / Desktop) & Cố định giao diện Mobile
# ==============================================================================

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # --------------------------------------------------------------------------
    # 1. NHẬN DIỆN THIẾT BỊ DI ĐỘNG (MOBILE / SMARTPHONE / TABLET)
    # --------------------------------------------------------------------------
    # Regex đối soát toàn bộ các User-Agent của smartphone & tablet phổ biến:
    # iPhone, iPad, iPod, Android, BlackBerry, IEMobile, Opera Mini, Silk, etc.
    RewriteCond %{HTTP_USER_AGENT} "android|blackberry|googlebot-mobile|iemobile|ipad|iphone|ipod|opera mini|palmos|webos|mobile|tablet|smartphone|kindle|silk|fennec" [NC]
    RewriteRule .* - [E=IS_MOBILE:1,E=DEVICE_TYPE:mobile]

    # --------------------------------------------------------------------------
    # 2. THIẾT LẬP COOKIE NHẬN DIỆN THIẾT BỊ CHO CLIENT-SIDE JAVASCRIPT
    # --------------------------------------------------------------------------
    # Nếu là Mobile: Ghi cookie "tuhocai_device=mobile", thời hạn 30 ngày (2592000 giây)
    RewriteCond %{ENV:IS_MOBILE} =1
    RewriteRule .* - [CO=tuhocai_device:mobile:%{HTTP_HOST}:2592000:/]

    # Nếu là Desktop: Ghi cookie "tuhocai_device=desktop", thời hạn 30 ngày
    RewriteCond %{ENV:IS_MOBILE} !=1
    RewriteRule .* - [CO=tuhocai_device:desktop:%{HTTP_HOST}:2592000:/]

    # --------------------------------------------------------------------------
    # 3. HEADER ĐIỀU HƯỚNG & KHÓA CỨNG VIEWPORT
    # --------------------------------------------------------------------------
    <IfModule mod_headers.c>
        # Báo hiệu cho server/proxy downstream biết thiết bị đang truy cập
        Header set X-Device-Type "mobile" env=IS_MOBILE
        Header set X-Device-Type "desktop" "expr=! -T %{ENV:IS_MOBILE}"
        
        # Ngăn chặn cache chéo giữa mobile và desktop (Vary theo User-Agent)
        Header append Vary "User-Agent"
        
        # Cố định tương thích trình duyệt
        Header set X-UA-Compatible "IE=edge"
    </IfModule>
</IfModule>

# ------------------------------------------------------------------------------
# 4. TỐI ƯU HÓA BỘ NHỚ ĐỆM & NÉN GZIP TỐC ĐỘ CAO CHO DI ĐỘNG
# ------------------------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
    AddOutputFilterByType DEFLATE text/javascript application/javascript application/x-javascript application/json
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
</IfModule>

